---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - posts
    - projects
    - gardenandprojects
permalink: /tags/{{ tag | slugify }}/
layout: layout.njk
eleventyComputed:
  title: "Tagged “{{ tag }}” | Questadon"
---
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/projects/"><span aria-hidden="true">←</span> Games &amp; More</a>
</nav>

<header class="page-head">
  <p class="eyebrow">Tagged</p>
  <h1>{{ tag }}</h1>
</header>

{% set postList = collections[tag] | reverse %}
{% set postTag = "h2" %}
{% include "post-list.njk" %}
