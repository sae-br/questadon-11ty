{# Home: three projects, skipping Final Light (it's the hero). #}
{% set homeProjects = collections.projects | except("/projects/final-light-ttrpg/", 3) %}
<section class="section" aria-labelledby="games-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Games &amp; More</p>
      <h2 id="games-title">Free for your table</h2>
    </div>
    <a class="link-arrow" href="/projects/">View all <span aria-hidden="true">→</span></a>
  </div>
  {% if homeProjects.length %}
  <div class="card-grid card-grid--scroll">
    {% set cardTag = "h3" %}
    {% asyncEach project in homeProjects %}{% include "project-card.njk" %}{% endeach %}
  </div>
  {% else %}
  <p>Nothing here yet.</p>
  {% endif %}
</section>
