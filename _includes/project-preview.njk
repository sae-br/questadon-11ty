<section class="preview-section">
  <h2 class="preview-heading">Games &amp; More</h2>
  {% if collections.projects | length %}
  <div class="project-grid">
    {% for project in collections.projects %}
      {% if loop.index <= 3 %}
      <a class="project-card" href="{{ project.url }}">
        {% if project.data.cardImage %}
        <div class="project-card__media" style="--card-focus: {{ project.data.cardImageFocus | default('center') }}">
          {% image project.data.cardImage, project.data.cardImageAlt or project.data.title, "(max-width: 540px) 100vw, 440px" %}
        </div>
        {% endif %}
        <h3 class="project-card__title">{{ project.data.title }}</h3>
        <p class="project-card__blurb">{{ project.data.description }}</p>
      </a>
      {% endif %}
    {% endfor %}
  </div>
  <a class="preview-link" href="/projects/">See everything →</a>
  {% else %}
  <p>Nothing here yet.</p>
  {% endif %}
</section>
