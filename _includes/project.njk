---
layout: layout.njk
---
{# Project write-up: header, key art, then the body beside a sticky panel
   (buy/try button, facts, related post, tags), and other projects to finish.

   Front matter: heading (short name; `title` stays the <title>), kicker,
   lead, heroImage/heroImageTall/heroImageAlt, ctaText/ctaUrl/ctaExternal,
   ctaSecondaryText/ctaSecondaryUrl/ctaSecondaryExternal, ctaNote,
   specs: [{label, value}], relatedPost: {url, label}. #}
<article class="project-page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/projects/"><span aria-hidden="true">←</span> Games &amp; More</a>
  </nav>

  <header class="project-head">
    {% if kicker %}<p class="eyebrow eyebrow--hi">{{ kicker }}</p>{% endif %}
    <h1>{{ heading or title }}</h1>
    {% set leadText = lead or description %}
    {% if leadText %}<p class="lede">{{ leadText }}</p>{% endif %}
  </header>

  {% set hero = heroImage or cardImage %}
  {% if hero %}
  <div class="hero-media">
    {% heroPicture hero, heroImageTall, heroImageAlt or cardImageAlt or title,
        { sizes: "(max-width: 1280px) 100vw, 1200px", breakpoint: "760px", eager: true } %}
  </div>
  {% endif %}

  <div class="with-panel">
    {# Panel comes first in the DOM so it precedes the long description for
       keyboard and screen-reader users; the grid places it on the right. #}
    <aside class="with-panel__aside project-panel" aria-label="Where to get it">
      {% if ctaUrl %}
      <div class="btn-stack">
        <a class="btn" href="{{ ctaUrl }}"
           {% if ctaExternal %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ ctaText or "Learn more" }}{% if ctaExternal %} <span aria-hidden="true">↗</span>{% endif %}</a>
        {% if ctaSecondaryUrl %}
        <a class="btn btn--ghost" href="{{ ctaSecondaryUrl }}"
           {% if ctaSecondaryExternal %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ ctaSecondaryText or "More" }}</a>
        {% endif %}
      </div>
      {% if ctaNote %}<p class="project-panel__note">{{ ctaNote }}</p>{% endif %}
      {% endif %}

      {% if specs %}
      <dl class="facts">
        {% for spec in specs %}
        <div>
          <dt class="eyebrow">{{ spec.label }}</dt>
          <dd>{{ spec.value }}</dd>
        </div>
        {% endfor %}
      </dl>
      {% endif %}

      {% if relatedPost %}
      <a class="link-arrow" href="{{ relatedPost.url }}">{{ relatedPost.label }} <span aria-hidden="true">→</span></a>
      {% endif %}

      {% if tags %}
      <ul class="tag-list" aria-label="Tags">
        {% for tag in tags %}
          {% if tag != "project" and tag != "posts" %}
          <li><a href="/tags/{{ tag | slugify }}/" class="tag-pill">{{ tag }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
      {% endif %}
    </aside>

    <div class="with-panel__main prose__content">
      {{ content | safe }}
    </div>
  </div>

  {# Other projects, newest first #}
  {% set others = collections.projects | except(page.url, 3) %}
  {% if others.length %}
  <section class="project-more" aria-labelledby="more-title">
    <div class="section-head">
      <h2 id="more-title">More for your table</h2>
      <a class="link-arrow" href="/projects/">View all <span aria-hidden="true">→</span></a>
    </div>
    <div class="card-grid card-grid--scroll">
      {% set cardTag = "h3" %}
      {% asyncEach project in others %}{% include "project-card.njk" %}{% endeach %}
    </div>
  </section>
  {% endif %}
</article>
