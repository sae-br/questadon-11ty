---
layout: layout.njk
---
{# An update. main--reading (posts/posts.json) centres it in one column. #}
<article class="post">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/posts/"><span aria-hidden="true">←</span> Updates</a>
  </nav>

  <header class="post__header">
    {% if date %}<p class="eyebrow"><time datetime="{{ date | dateToRfc3339 }}">{{ date | readableDate }}</time></p>{% endif %}
    <h1 class="post__title">{{ title }}</h1>
    {% if description %}<p class="lede">{{ description }}</p>{% endif %}
    {% set postTags = (tags or []) | reject("equalto", "project") | reject("equalto", "posts") %}
    {% if postTags | length %}
    <ul class="tag-list" aria-label="Tags">
      {% for tag in postTags %}
      <li><a href="/tags/{{ tag | slugify }}/" class="tag-pill">{{ tag }}</a></li>
      {% endfor %}
    </ul>
    {% endif %}
  </header>

  <div class="prose__content">
    {{ content | safe }}
  </div>
</article>
