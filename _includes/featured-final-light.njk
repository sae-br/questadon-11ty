<section class="featured" aria-labelledby="featured-heading">
  <div class="featured__art">
    {% heroPicture
        "./assets/feature-banner-final-light.jpg",
        "./assets/feature-banner-final-light-tall.jpg",
        "",
        { sizes: "100vw", breakpoint: "860px", eager: true } %}
  </div>

  <div class="featured__inner">
    <div class="featured__content">
      <h2 class="featured__heading" id="featured-heading">
        <img class="featured__logo" src="/assets/final-light-logo-web.png"
             alt="Final Light" width="800" height="617" loading="eager" decoding="async">
      </h2>
      <p class="featured__tagline">A survival-horror TTRPG for telling short, high-stakes zombie stories with your friends.</p>
      <ul class="featured__stats">
        <li>Funded in one minute</li>
        <li>Over 4200% funded</li>
        <li>Late pledges open</li>
      </ul>
      <div class="featured__actions">
        <a class="featured__cta"
           href="https://www.kickstarter.com/projects/heysarahbrown/final-light-a-cinematic-short-form-survival-ttrpg?ref=72yvgd"
           target="_blank" rel="noopener noreferrer">Back it on Kickstarter</a>
        <a class="featured__cta featured__cta--ghost" href="/projects/final-light-ttrpg/">See what's inside</a>
      </div>
    </div>
  </div>
</section>
