{# Home: full-bleed Final Light hero, then one player quote. The hero slides
   up under the translucent header (see .hero in styles.css). #}
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__art">
    {% heroPicture
        "./assets/feature-banner-final-light.jpg", "./assets/feature-banner-final-light-tall.jpg", "",
        { sizes: "100vw", breakpoint: "760px", eager: true } %}
  </div>

  <div class="wrap">
    <div class="hero__content">
      <p class="eyebrow eyebrow--hi">Funded on Kickstarter in one minute</p>
      <h2 class="hero__title" id="hero-title">
        <img class="hero__logo" src="/assets/final-light-logo-web.png"
             alt="Final Light" width="800" height="617" loading="eager" decoding="async">
      </h2>
      <p class="lede hero__tagline">Short, high-stakes zombie stories for 2–4 players. You are not heroes trying to fix it. You are survivors trying to get through it.</p>
      <div class="hero__actions">
        <a class="btn" href="/projects/final-light-ttrpg/">Explore Final Light</a>
        <a class="btn btn--ghost" href="/projects/final-light-ttrpg/#quick-start">Free Quick Start</a>
      </div>
    </div>
  </div>
</section>

<div class="wrap">
<figure class="proof">
  <div>
    <blockquote><p>“The tensest RPG <span class="proof__accent">I’ve ever run.</span>”</p></blockquote>
  </div>
  <a class="link-arrow" href="/projects/final-light-ttrpg/#what-players-say">See what players say <span aria-hidden="true">→</span></a>
</figure>
</div>
