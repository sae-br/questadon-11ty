<section class="newsletter-box" id="newsletter" aria-labelledby="newsletter-heading">
  <h2 class="newsletter-box__heading" id="newsletter-heading">{{ newsletterHeading | default("Don't split the party") }}</h2>
  <p class="newsletter-box__blurb">{{ newsletterBlurb | default("Let's go together (by email). Updates, releases, only the good stuff.") }}</p>
  <script async src="https://eomail5.com/form/26022422-aad5-11f1-a11e-bdd4cfec24d4.js" data-form="26022422-aad5-11f1-a11e-bdd4cfec24d4"></script>
  <script>
    // EmailOctopus dispatches this on document once a signup succeeds - an
    // official hook in their embed, so we are not scraping their markup.
    // The flag keeps the count honest if this partial ever appears twice on
    // one page; the listener would otherwise bind twice and double-fire.
    if (!window.__newsletterSignupTracked) {
      window.__newsletterSignupTracked = true;
      document.addEventListener("emailoctopus:form.success", function () {
        if (typeof gtag === "function") gtag("event", "newsletter_signup");
      });
    }
  </script>
  <p class="newsletter-box__recaptcha">
    This site is protected by reCAPTCHA and the Google
    <a href="https://policies.google.com/privacy" rel="noopener">Privacy Policy</a> and
    <a href="https://policies.google.com/terms" rel="noopener">Terms of Service</a> apply.
  </p>
</section>
