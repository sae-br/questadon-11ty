{# Home: the latest updates. #}
<section class="section" aria-labelledby="updates-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">Updates</p>
      <h2 id="updates-title">From the studio</h2>
    </div>
    <a class="link-arrow" href="/posts/">All updates <span aria-hidden="true">→</span></a>
  </div>
  {% if collections.posts | length %}
    {% set postList = collections.posts | limit(3) %}
    {% set postTag = "h3" %}
    {% include "post-list.njk" %}
  {% else %}
  <p>Nothing here yet.</p>
  {% endif %}
</section>
