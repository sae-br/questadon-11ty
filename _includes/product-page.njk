---
layout: layout.njk
---
{# Product page: a game (or any product) being sold, not a project write-up.
   Reusable - everything page-specific comes from front matter:

     heading / subtitle / lead   header block (`title` stays the <title>)
     heroImage, heroImageTall, heroImageAlt
     accent, accentLight         the product's own colour, dark and light theme
     ctaText/ctaUrl, ctaSecondaryText/ctaSecondaryUrl
     facts: [{label, value}]     shown as a compact 2x2 grid in the panel
     toc: [{id, label}]          "On this page" links; ids are the H2 ids

   The body is written with the product-* classes (see the PRODUCT PAGE
   section of styles.css). Styling is scoped to .product so it never leaks
   into the rest of the site's brand palette. #}
<article class="product"{% if accent %} style="--product-accent: {{ accent }};{% if accentLight %} --product-accent-light: {{ accentLight }};{% endif %}"{% endif %}>
  <nav class="product__breadcrumb" aria-label="Breadcrumb">
    <a href="/projects/"><span aria-hidden="true">←</span> Games &amp; More</a>
  </nav>

  {% if heroImage %}
  <div class="product__media">
    {% heroPicture heroImage, heroImageTall, heroImageAlt or title,
        { sizes: "(max-width: 1204px) 100vw, 1140px", breakpoint: "860px", eager: true } %}
  </div>
  {% endif %}

  <header class="product__header">
    <h1 class="product__title">{{ heading or title }}</h1>
    {% if subtitle %}<p class="product__subtitle">{{ subtitle }}</p>{% endif %}
    {% if lead %}<p class="product__lead">{{ lead }}</p>{% endif %}
  </header>

  <div class="product__layout">
    {# First in the DOM so keyboard and screen-reader users reach the buy
       buttons before the long read; the grid puts it on the right. #}
    <aside class="product__panel" aria-label="Get {{ heading or title }}">
      <div class="product__actions">
        {% if ctaUrl %}<a class="product-btn" href="{{ ctaUrl }}">{{ ctaText }}</a>{% endif %}
        {% if ctaSecondaryUrl %}<a class="product-btn product-btn--ghost" href="{{ ctaSecondaryUrl }}">{{ ctaSecondaryText }}</a>{% endif %}
      </div>

      {% if facts %}
      <dl class="product__facts">
        {% for fact in facts %}
        <div>
          <dt>{{ fact.label }}</dt>
          <dd>{{ fact.value }}</dd>
        </div>
        {% endfor %}
      </dl>
      {% endif %}

      {% if toc %}
      <nav class="product__toc" aria-label="On this page">
        <p class="product__toc-label">On this page</p>
        <ul>
          {% for item in toc %}
          <li><a href="#{{ item.id }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      {% endif %}
    </aside>

    <div class="product__body">
      {{ content | safe }}
    </div>
  </div>
</article>

{% if toc %}<script src="/assets/product-nav.js" defer></script>{% endif %}
