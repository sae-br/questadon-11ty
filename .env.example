# Copy to .env for local `netlify dev`. Never commit real values -
# in production these live in Netlify's environment variables.

# EmailOctopus API key: https://emailoctopus.com/developer/api-keys
EO_API_KEY=eo_your_api_key_here

# The list the Final Light Quick Start form subscribes people to.
EO_LIST_ID=your_list_id_here
